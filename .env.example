# =================================================================
# AIScraper configuration.  Copy to .env and edit for your setup.
# NEVER commit a real .env to git.
# =================================================================

# --- App ---------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
APP_TIMEZONE=UTC

# --- Database (matches docker-compose.yml service name) ---------
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=aiscraper
DB_USER=aiscraper
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Target ------------------------------------------------------
TARGET_URL=https://finance.yahoo.com/topic/stock-market-news/
ARTICLE_URL_PATTERN=^https?://finance\.yahoo\.com/news/.*\.html$

# --- Rate limiting / stealth -------------------------------------
# COMBINED across both stages. Keep conservative.
REQUESTS_PER_MINUTE=8
MIN_DELAY_SEC=1.5
MAX_DELAY_SEC=4.0
MAX_CONCURRENT_REQUESTS=2
MAX_RETRY_ATTEMPTS=4
BACKOFF_BASE_SEC=2.0
BACKOFF_MAX_SEC=60.0
# 403/429/CAPTCHA streak before full cooldown
FAILURE_THRESHOLD=3
FAILURE_COOLDOWN_SEC=300
RESPECT_ROBOTS_TXT=true
# If empty, rotates from the built-in pool
USER_AGENT=

# --- Crawl4AI ----------------------------------------------------
CRAWL4AI_MAX_SCROLL_COUNT=25
CRAWL4AI_SCROLL_PAUSE_SEC=1.2
CRAWL4AI_PAGE_TIMEOUT_SEC=45
CRAWL4AI_CACHE_ENABLED=true
CRAWL4AI_SIMULATE_USER=true
CRAWL4AI_MAGIC=true
CRAWL4AI_WAIT_FOR=css:li.js-stream-content
CRAWL4AI_VIEWPORT_MIN_W=1280
CRAWL4AI_VIEWPORT_MIN_H=800
CRAWL4AI_VIEWPORT_MAX_W=1920
CRAWL4AI_VIEWPORT_MAX_H=1080
CRAWL4AI_HEADLESS=true

# --- LLM extractor (Tier 8, optional) ----------------------------
ENABLE_LLM_EXTRACTOR=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_OLLAMA_BASE_URL=http://localhost:11434

# --- Scheduler ---------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30
SCHEDULER_RUN_ON_START=true
# Re-scrape an article if last scrape older than this
RECHECK_WINDOW_HOURS=12
FORCE_REFRESH=false

# --- Incremental crawl / pagination ------------------------------
# When the DB is empty, how far back to scrape (days).
INITIAL_SCRAPE_DAYS=3
# Yahoo Finance topic pages accept ?start=<offset>&count=<N>; this
# is the page size the crawler walks.
PAGINATION_PAGE_SIZE=10
# Safety cap on number of listing pages fetched per run.
PAGINATION_MAX_PAGES=100
# Stop paginating early when this many consecutive cards are already
# in the DB (or older than the cutoff).
PAGINATION_STOP_AFTER_CONSECUTIVE_OLD=8
