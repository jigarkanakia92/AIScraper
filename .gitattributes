# Keep the repository byte-identical on every platform. This matters most for
# shell scripts and the Dockerfile: on a Windows checkout the default
# `core.autocrlf=true` rewrites them with CRLF, and a CRLF shebang
# ("#!/bin/sh\r") makes the kernel fail with ENOENT — which surfaces as
#   [dumb-init] /usr/local/bin/docker-entrypoint.sh: No such file or directory
* text=auto eol=lf

*.sh             text eol=lf
Dockerfile       text eol=lf
*.dockerfile     text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.json           text eol=lf
*.py             text eol=lf
*.ini            text eol=lf
*.toml           text eol=lf
*.md             text eol=lf

# Windows-only helpers must keep CRLF.
*.bat            text eol=crlf
*.cmd            text eol=crlf

# Binary assets: never touch.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.pdf            binary
*.whl            binary
*.gz             binary
*.zip            binary
